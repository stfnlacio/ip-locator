# Function to lookup IP
lookup() {
  local ip="$1"
  local url

  if [ -z "$ip" ]; then
    url="https://ipapi.co/json/"
  else
    url="https://ipapi.co/${ip}/json/"
  fi

  response=$(curl -s --max-time 10 "$url")

  if [ -z "$response" ]; then
    echo -e "${RED}[!] Error: Could not connect to the API${RESET}"
    return 1
  fi

  python3 -c "
import json, sys
try:
    data = json.loads('''$response''')
except:
    print('${RED}[!] Invalid response from API${RESET}')
    sys.exit(1)

if data.get('error'):
    print('${RED}[!] Error:${RESET}', data.get('reason', 'Unknown error'))
    sys.exit(1)

ip = data.get('ip', 'N/A')
org = data.get('org', 'N/A')
city = data.get('city', 'N/A')
region = data.get('region', 'N/A')
country = data.get('country_name', 'N/A')
lat = data.get('latitude', 'N/A')
lon = data.get('longitude', 'N/A')

print(f'''${YELLOW}>>> IP address details${RESET}

${GREEN}1) IP Address :${RESET}  ${YELLOW}{ip}${RESET}
${GREEN}2) Org        :${RESET}  ${YELLOW}{org}${RESET}
${GREEN}3) City       :${RESET}  ${YELLOW}{city}${RESET}
${GREEN}4) Region     :${RESET}  ${YELLOW}{region}${RESET}
${GREEN}5) Country    :${RESET}  ${YELLOW}{country}${RESET}
${GREEN}6) Location${RESET}
        ${GREEN}Latitude  :${RESET}  {lat}
        ${GREEN}Longitude :${RESET}  {lon}

${CYAN}# Google Map link :${RESET}  ${BLUE}https://www.google.com/maps/place/{lat}+{lon}${RESET}
''')
"

  echo
}

# Main menu loop
while true; do
  show_banner

  echo -e "${RED}# Select option >>${RESET}"
  echo
  echo -e "${GREEN}1) Check your IP info${RESET}"
  echo -e "${GREEN}2) Check other IP info${RESET}"
  echo -e "${GREEN}3) Exit${RESET}"
  echo
  echo -ne "${CYAN}Enter Your choice: ${RESET}"
  read choice

  case $choice in
    1)
      echo
      echo -e "${YELLOW}[*] Detecting your current public IP...${RESET}"
      echo
      lookup
      echo -e "${BLUE}Press Enter to continue...${RESET}"
      read
      ;;
    2)
      echo
      echo -ne "${YELLOW}>>> Enter IP Address: ${RESET}"
      read target_ip
      echo
      if [ -z "$target_ip" ]; then
        echo -e "${RED}[!] No IP entered${RESET}"
        sleep 1
      else
        lookup "$target_ip"
        echo -e "${BLUE}Press Enter to continue...${RESET}"
        read
      fi
      ;;
    3)
      echo
      echo -e "${PURPLE}Thank you for using IP Locator by Stefan Lacio!${RESET}"
      echo
      exit 0
      ;;
    *)
      echo -e "${RED}[!] Invalid option. Please choose 1, 2 or 3.${RESET}"
      sleep 1
      ;;
  esac
done
