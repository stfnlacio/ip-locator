#!/usr/bin/env bash

# Colors
CYAN='\033[0;36m'
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
PURPLE='\033[0;35m'
RED='\033[0;31m'
RESET='\033[0m'
BOLD='\033[1m'

# Function to show banner
show_banner() {
  clear
  echo -e "${CYAN}"
  cat << "EOF"
   ██████╗ ██╗██████╗      ██╗      ██████╗  ██████╗ █████╗ ████████╗ ██████╗ ██████╗ 
  ██╔════╝ ██║██╔══██╗     ██║     ██╔═══██╗██╔════╝██╔══██╗╚══██╔══╝██╔═══██╗██╔══██╗
  ██║  ███╗██║██████╔╝     ██║     ██║   ██║██║     ███████║   ██║   ██║   ██║██████╔╝
  ██║   ██║██║██╔═══╝      ██║     ██║   ██║██║     ██╔══██║   ██║   ██║   ██║██╔══██╗
  ╚██████╔╝██║██║          ███████╗╚██████╔╝╚██████╗██║  ██║   ██║   ╚██████╔╝██║  ██║
