#!/usr/bin/env bash

# Colors
CYAN='\033[0;36m'
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
PURPLE='\033[0;35m'
RED='\033[0;31m'
RESET='\033[0m'
BOLD='\033[1m'

clear

# Clean Banner (mobile-friendly)
echo -e "${CYAN}"
cat << "EOF"
  ██╗██████╗     ██╗      ██████╗  ██████╗ █████╗ ████████╗ ██████╗ ██████╗
  ██║██╔══██╗    ██║     ██╔═══██╗██╔════╝██╔══██╗╚══██╔══╝██╔═══██╗██╔══██╗
  ██║██████╔╝    ██║     ██║   ██║██║     ███████║   ██║   ██║   ██║██████╔╝
  ██║██╔═══╝     ██║     ██║   ██║██║     ██╔══██║   ██║   ██║   ██║██╔══██╗
  ██║██║         ███████╗╚██████╔╝╚██████╗██║  ██║   ██║   ╚██████╔╝██║  ██║
  ╚═╝╚═╝         ╚══════╝ ╚═════╝  ╚═════╝╚═╝  ╚═╝   ╚═╝    ╚═════╝ ╚═╝  ╚═╝
EOF
echo -e "${RESET}"

# Lookup function with multiple free APIs (auto fallback)
lookup() {
  local ip="$1"
  local response=""
  local api_used=""

  try_api() {
    local url="$1"
    local name="$2"
    response=$(curl -s --max-time 8 -A "Mozilla/5.0 (Linux; Android 13)" "$url" 2>/dev/null)
    if [ -n "$response" ] && echo "$response" | grep -qE '"(ip|query|status|city)"'; then
      api_used="$name"
      return 0
    fi
    return 1
  }

  if [ -z "$ip" ]; then
    echo -e "${YELLOW}[*] Detecting your current public IP...${RESET}"
    try_api "http://ip-api.com/json/?fields=status,message,query,country,countryCode,regionName,city,lat,lon,timezone,isp,as,org" "ip-api.com" || \
    try_api "https://ipinfo.io/json" "ipinfo.io" || \
    try_api "https://ipwho.is/" "ipwho.is" || \
    try_api "https://ipapi.co/json/" "ipapi.co"
  else
    echo -e "${YELLOW}[*] Looking up IP: ${BOLD}${ip}${RESET}"
    try_api "http://ip-api.com/json/${ip}?fields=status,message,query,country,countryCode,regionName,city,lat,lon,timezone,isp,as,org" "ip-api.com" || \
    try_api "https://ipinfo.io/${ip}/json" "ipinfo.io" || \
    try_api "https://ipwho.is/${ip}" "ipwho.is" || \
    try_api "https://ipapi.co/${ip}/json/" "ipapi.co"
  fi

  echo

  if [ -z "$response" ]; then
    echo -e "${RED}[!] Error: All free APIs failed or rate limited${RESET}"
    return 1
  fi

  echo -e "${CYAN}[*] Source: ${api_used}${RESET}"
  echo

  python3 -c "
import json, sys
try:
    data = json.loads('''$response''')
except:
    print('${RED}[!] Invalid response from API${RESET}')
    sys.exit(1)

ip       = data.get('ip') or data.get('query') or 'N/A'
city     = data.get('city') or 'N/A'
region   = data.get('region') or data.get('regionName') or data.get('region_code') or 'N/A'
country  = data.get('country_name') or data.get('country') or 'N/A'
cc       = data.get('country_code') or data.get('countryCode') or ''
lat      = data.get('latitude') or data.get('lat') or 'N/A'
lon      = data.get('longitude') or data.get('lon') or 'N/A'
timezone = data.get('timezone') or 'N/A'
org      = data.get('org') or data.get('isp') or data.get('connection', {}).get('isp') or 'N/A'
asn      = data.get('asn') or data.get('as') or data.get('connection', {}).get('asn') or 'N/A'

if data.get('status') == 'fail' or data.get('success') is False or data.get('error'):
    print('${RED}[!] Error:${RESET}', data.get('message') or data.get('reason') or 'Unknown error')
    sys.exit(1)

print(f'''${GREEN}${BOLD}IP Address  :${RESET} {ip}
${GREEN}${BOLD}City        :${RESET} {city}
${GREEN}${BOLD}Region      :${RESET} {region}
${GREEN}${BOLD}Country     :${RESET} {country} ({cc})
${GREEN}${BOLD}Coordinates :${RESET} {lat}, {lon}
${GREEN}${BOLD}Timezone    :${RESET} {timezone}
${GREEN}${BOLD}ISP / Org   :${RESET} {org}
${GREEN}${BOLD}ASN         :${RESET} {asn}
''')
"
}

# Help
if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo -e "${CYAN}Usage:${RESET}"
  echo "  ip-locator              Show your own IP info"
  echo "  ip-locator 8.8.8.8      Lookup any IP address"
  echo "  ip-locator --help       Show this help"
  echo
  exit 0
fi

# Run
lookup "$1"

echo
echo -e "${BLUE}──────────────────────────────────────────────────────────────${RESET}"
echo -e "${PURPLE}                 Made with ❤️  by Stefan Lacio${RESET}"
echo
