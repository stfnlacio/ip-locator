#!/usr/bin/env bash

# Colors
CYAN='\033[0;36m'
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
PURPLE='\033[0;35m'
RED='\033[0;31m'
RESET='\033[0m'
BOLD='\033[1m'

# Get terminal width (fallback to 80 if it can't be detected)
term_width() {
  local w
  w=$(tput cols 2>/dev/null)
  if [ -z "$w" ]; then
    w=80
  fi
  echo "$w"
}

# Draw a separator line that fits the current terminal width
draw_line() {
  local width
  width=$(term_width)
  printf "${BLUE}"
  printf '%*s' "$width" '' | tr ' ' '-'
  printf "${RESET}\n"
}

# Function to show banner (responsive: wide ASCII art on wide terminals,
# compact text logo on narrow ones like a phone screen in Termux)
show_banner() {
  clear
  local width
  width=$(term_width)

  if [ "$width" -ge 90 ]; then
    echo -e "${CYAN}"
    cat << "EOF"
   ██████╗ ██╗██████╗      ██╗      ██████╗  ██████╗ █████╗ ████████╗ ██████╗ ██████╗ 
  ██╔════╝ ██║██╔══██╗     ██║     ██╔═══██╗██╔════╝██╔══██╗╚══██╔══╝██╔═══██╗██╔══██╗
  ██║  ███╗██║██████╔╝     ██║     ██║   ██║██║     ███████║   ██║   ██║   ██║██████╔╝
  ██║   ██║██║██╔═══╝      ██║     ██║   ██║██║     ██╔══██║   ██║   ██║   ██║██╔══██╗
  ╚██████╔╝██║██║          ███████╗╚██████╔╝╚██████╗██║  ██║   ██║   ╚██████╔╝██║  ██║
   ╚═════╝ ╚═╝╚═╝          ╚══════╝ ╚═════╝  ╚═════╝╚═╝  ╚═╝   ╚═╝    ╚═════╝ ╚═╝  ╚═╝
EOF
    echo -e "${RESET}"
  else
    # Compact logo for narrow terminals (phones, split-screen, etc.)
    echo -e "${CYAN}${BOLD}"
    echo "   ___ ____    _                _            "
    echo "  |_ _|  _ \  | |    ___   ___ | |_ ___  _ __ "
    echo "   | || |_) | | |   / _ \ / __|| __/ _ \| '__|"
    echo "   | ||  __/  | |__| (_) | (__ | || (_) | |   "
    echo "  |___|_|     |_____\___/ \___| \__\___/|_|   "
    echo -e "${RESET}"
  fi

  echo -e "${PURPLE}                Created by Stefan Lacio${RESET}"
  draw_line
  echo
}

# Function to lookup IP
lookup() {
  local ip="$1"
  local url

  if [ -z "$ip" ]; then
    url="https://ipapi.co/json/"
  else
    url="https://ipapi.co/${ip}/json/"
  fi

  response=$(curl -s --max-time 10 "$url")

  if [ -z "$response" ]; then
    echo -e "${RED}[!] Error: Could not connect to the API${RESET}"
    return 1
  fi

  # IMPORTANT: the response is passed through the environment (RESPONSE)
  # and the python code lives in a QUOTED heredoc ('PYEOF'), so nothing
  # in the API response can ever be interpreted as shell or python source.
  # This is what was broken before: the raw JSON was spliced directly
  # into a double-quoted -c "..." string, and any " character in the
  # response (which JSON is full of) closed that string early and broke
  # the whole command -- which is why options 1 and 2 failed.
  RESPONSE="$response" python3 << 'PYEOF'
import json
import os
import sys

response = os.environ.get('RESPONSE', '')

try:
    data = json.loads(response)
except Exception:
    print('[!] Invalid response from API')
    sys.exit(1)

if data.get('error'):
    print('[!] Error:', data.get('reason', 'Unknown error'))
    sys.exit(1)

ip = data.get('ip', 'N/A')
org = data.get('org', 'N/A')
city = data.get('city', 'N/A')
region = data.get('region', 'N/A')
country = data.get('country_name', 'N/A')
lat = data.get('latitude', 'N/A')
lon = data.get('longitude', 'N/A')

CYAN = '\033[0;36m'
GREEN = '\033[0;32m'
YELLOW = '\033[1;33m'
BLUE = '\033[0;34m'
RESET = '\033[0m'

print(f'''{YELLOW}>>> IP address details{RESET}

{GREEN}1) IP Address :{RESET}  {YELLOW}{ip}{RESET}
{GREEN}2) Org        :{RESET}  {YELLOW}{org}{RESET}
{GREEN}3) City       :{RESET}  {YELLOW}{city}{RESET}
{GREEN}4) Region     :{RESET}  {YELLOW}{region}{RESET}
{GREEN}5) Country    :{RESET}  {YELLOW}{country}{RESET}
{GREEN}6) Location{RESET}
        {GREEN}Latitude  :{RESET}  {lat}
        {GREEN}Longitude :{RESET}  {lon}

{CYAN}# Google Map link :{RESET}  {BLUE}https://www.google.com/maps/place/{lat}+{lon}{RESET}
''')
PYEOF

  echo
}

# Main menu loop
while true; do
  show_banner

  echo -e "${RED}# Select option >>${RESET}"
  echo
  echo -e "${GREEN}1) Check your IP info${RESET}"
  echo -e "${GREEN}2) Check other IP info${RESET}"
  echo -e "${GREEN}3) Exit${RESET}"
  echo
  echo -ne "${CYAN}Enter Your choice: ${RESET}"
  read choice

  case $choice in
    1)
      echo
      echo -e "${YELLOW}[*] Detecting your current public IP...${RESET}"
      echo
      lookup
      echo -e "${BLUE}Press Enter to continue...${RESET}"
      read
      ;;
    2)
      echo
      echo -ne "${YELLOW}>>> Enter IP Address: ${RESET}"
      read target_ip
      echo
      if [ -z "$target_ip" ]; then
        echo -e "${RED}[!] No IP entered${RESET}"
        sleep 1
      else
        lookup "$target_ip"
        echo -e "${BLUE}Press Enter to continue...${RESET}"
        read
      fi
      ;;
    3)
      echo
      echo -e "${PURPLE}Thank you for using IP Locator by Stefan Lacio!${RESET}"
      echo
      exit 0
      ;;
    *)
      echo -e "${RED}[!] Invalid option. Please choose 1, 2 or 3.${RESET}"
      sleep 1
      ;;
  esac
done
